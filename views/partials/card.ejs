<%
  const cardLabels = card.labels.map((id) => model.labels.find((label) => label.id === id)).filter(Boolean);
  const cardMembers = card.memberIds.map((id) => model.members.find((member) => member.id === id)).filter(Boolean);
  const progress = checklistProgress(card);
  const state = dueState(card.dueAt, card.dueComplete);
  const dueClasses = {
    later: "bg-slate-100 text-slate-700",
    soon: "bg-amber-100 text-amber-900",
    overdue: "bg-red-100 text-red-800",
    "overdue-long": "bg-rose-100 text-rose-800",
    complete: "bg-emerald-100 text-emerald-800",
    none: "hidden"
  };
%>
<article
  id="card-<%= card.id %>"
  data-card
  data-card-id="<%= card.id %>"
  data-card-drag-handle
  class="group cursor-pointer rounded-lg bg-white text-sm shadow-sm ring-1 ring-slate-900/5 hover:ring-blue-500"
  hx-get="/cards/<%= card.id %>"
  hx-target="#card-modal-shell"
  hx-swap="innerHTML"
  <%= oob ? 'hx-swap-oob="outerHTML"' : "" %>
>
  <% if (card.cover) { %>
    <div class="<%= cn("h-14 rounded-t-lg", coverStyles[card.cover.value] || coverStyles.slate) %>"></div>
  <% } %>

  <div class="grid gap-2 p-3">
    <% if (cardLabels.length) { %>
      <div class="flex flex-wrap gap-1">
        <% cardLabels.forEach((label) => { %>
          <span class="<%= cn("max-w-full truncate rounded px-2 py-0.5 text-[11px] font-medium", labelStyles[label.color] || labelStyles.gray) %>">
            <%= label.title %>
          </span>
        <% }) %>
      </div>
    <% } %>

    <div class="flex items-start gap-2">
      <form
        hx-patch="/cards/<%= card.id %>/quick"
        hx-target="#card-<%= card.id %>"
        hx-swap="outerHTML"
        hx-on:click="event.stopPropagation()"
        data-no-drag
      >
        <input type="hidden" name="dueComplete" value="<%= card.dueComplete ? "false" : "true" %>" />
        <button
          type="submit"
          class="<%= cn("mt-0.5 flex size-5 items-center justify-center rounded-full border", card.dueComplete ? "border-emerald-600 bg-emerald-600 text-white" : "border-slate-300 text-transparent hover:text-slate-500") %>"
          aria-label="<%= card.dueComplete ? "未完了に戻す" : "完了にする" %>"
        >
          <i data-lucide="check" class="size-3"></i>
        </button>
      </form>
      <h3 class="<%= cn("min-w-0 flex-1 text-pretty leading-5 text-slate-900", card.dueComplete && "text-slate-500 line-through") %>">
        <%= card.title %>
      </h3>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-600">
      <% if (card.description) { %>
        <span class="inline-flex items-center gap-1" title="説明あり"><i data-lucide="align-left" class="size-3.5"></i></span>
      <% } %>
      <% if (card.comments.length) { %>
        <span class="inline-flex items-center gap-1 tabular-nums"><i data-lucide="message-square" class="size-3.5"></i><%= card.comments.length %></span>
      <% } %>
      <% if (card.attachments.length) { %>
        <span class="inline-flex items-center gap-1 tabular-nums"><i data-lucide="paperclip" class="size-3.5"></i><%= card.attachments.length %></span>
      <% } %>
      <% if (progress.total) { %>
        <span class="<%= cn("inline-flex items-center gap-1 rounded px-1.5 py-0.5 tabular-nums", progress.done === progress.total ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-700") %>">
          <i data-lucide="square-check-big" class="size-3.5"></i>
          <%= progress.done %>/<%= progress.total %>
        </span>
      <% } %>
      <% if (card.dueAt) { %>
        <span class="<%= cn("inline-flex items-center gap-1 rounded px-1.5 py-0.5 tabular-nums", dueClasses[state]) %>">
          <i data-lucide="clock" class="size-3.5"></i>
          <%= dueLabel(card.dueAt, card.dueComplete) %>
        </span>
      <% } %>
    </div>

    <% if (cardMembers.length) { %>
      <div class="flex justify-end -space-x-1">
        <% cardMembers.forEach((member) => { %>
          <span class="<%= cn("flex size-7 items-center justify-center rounded-full border-2 border-white text-xs font-semibold text-white", member.color) %>" title="<%= member.name %>">
            <%= member.initials %>
          </span>
        <% }) %>
      </div>
    <% } %>
  </div>
</article>
